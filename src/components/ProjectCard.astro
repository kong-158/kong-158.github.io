---
interface Props { project: { title: string; eyebrow: string; status: string; description: string; tags: readonly string[]; href: string; }; }
const { project } = Astro.props;
---
<a class="project-card" href={project.href}>
  <div class="card-top"><span>{project.eyebrow}</span><span class="status">{project.status}</span></div>
  <h3>{project.title}</h3><p>{project.description}</p>
  <div class="tags">{project.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
</a>
