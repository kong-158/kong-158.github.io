---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { categories, topicLabels, kindLabels, formatDate } from '@/data/site';

const posts = (await getCollection('writing', ({ data }) =>
  !data.draft && data.visibility === 'public'
)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const recommended = posts.filter((post) => post.data.recommended);
const latest = posts.slice(0, 6);
const categoryCounts = Object.fromEntries(
  categories.map((category) => [
    category.slug,
    posts.filter((post) => post.data.topic === category.slug).length
  ])
);
const years = [...new Set(posts.map((post) => post.data.publishedAt.getFullYear()))];
---
<BaseLayout>
  <section class="profile-hero">
    <div class="shell profile-panel">
      <aside class="profile-sidebar">
        <img
          class="profile-avatar"
          src="https://avatars.githubusercontent.com/u/265462232?v=4"
          alt="个人头像"
          width="220"
          height="220"
        />
        <div class="profile-name-block">
          <p>KONG · PERSONAL NOTES</p>
        </div>
        <div class="profile-motto profile-motto-brush">
          <div
            class="profile-motto-script motto-font-sweep"
            data-random-motto
            data-columns="2"
            data-length="standard"
            role="img"
            aria-label="鹰击长空鲸霸海，不试怎知龙与蚯。"
          >
            <span class="motto-column">鹰击长空鲸霸海</span>
            <span class="motto-column">不试怎知龙与蚯</span>
          </div>
        </div>
      </aside>

      <div class="profile-introduction">
        <p class="report-label">PERSONAL PROFILE / 个人简介</p>
        <h2>你好，欢迎来到我的个人小站。</h2>
        <p class="profile-lead">
          目前就读于上海交通大学金融计算机 F24。
        </p>
        <p>
          你可以在这里看到我在学习、研究与实践中的思考，也会读到一些随笔和其他零散记录。我的兴趣会随时间变化，这个网站也会跟着不断调整和生长。感谢你的关注与阅读。
        </p>
        <div class="profile-links">
          <a href="/writing/">阅读文章</a>
          <a href="/topics/">浏览栏目</a>
          <a href="/about/">更多介绍</a>
        </div>
      </div>
    </div>
  </section>

  {recommended.length > 0 && (
    <section class="section section-tint">
      <div class="shell">
        <div class="section-heading">
          <div><span class="section-no">01</span><h2>推荐阅读</h2></div>
        </div>
        <div class="article-list featured-list">
          {recommended.map((post) => (
            <a class="article-row" href={`/writing/${post.id}/`}>
              <time>{formatDate(post.data.publishedAt)}</time>
              <div class="article-main">
                <h3>{post.data.title}</h3>
                <p>{post.data.summary}</p>
              </div>
              <div class="article-meta">{topicLabels[post.data.topic]} · {kindLabels[post.data.kind]}</div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <div><span class="section-no">{recommended.length > 0 ? '02' : '01'}</span><h2>最新文章</h2></div>
        <a class="text-link" href="/writing/">查看全部</a>
      </div>
      {latest.length > 0 ? (
        <div class="article-list">
          {latest.map((post) => (
            <a class="article-row" href={`/writing/${post.id}/`}>
              <time>{formatDate(post.data.publishedAt)}</time>
              <div class="article-main">
                <h3>{post.data.title}</h3>
                <p>{post.data.summary}</p>
              </div>
              <div class="article-meta">{topicLabels[post.data.topic]} · {kindLabels[post.data.kind]}</div>
            </a>
          ))}
        </div>
      ) : (
        <div class="quiet-empty">
          <strong>目前还没有文章。</strong>
          <p>新的内容会陆续出现在这里。</p>
        </div>
      )}
    </div>
  </section>

  <section class="section section-tint">
    <div class="shell">
      <div class="section-heading">
        <div><span class="section-no">{recommended.length > 0 ? '03' : '02'}</span><h2>栏目浏览</h2></div>
        <p>按主题浏览文章、笔记与其他内容。</p>
      </div>
      <div class="category-table">
        {categories.map((category) => (
          <a class="category-row" href={`/topics/#${category.slug}`}>
            <span class="category-index">{category.index}</span>
            <div><h3>{category.title}</h3><p>{category.description}</p></div>
            <span class="category-count">{categoryCounts[category.slug]} 篇</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {years.length > 0 && (
    <section class="section">
      <div class="shell archive-strip">
        <div><span class="section-no">{recommended.length > 0 ? '04' : '03'}</span><h2>按时间归档</h2></div>
        <div class="archive-years">
          {years.map((year) => <a href={`/archive/#year-${year}`}>{year}</a>)}
        </div>
      </div>
    </section>
  )}

  <style is:global>
    @import url('https://fonts.googleapis.com/css2?family=Liu+Jian+Mao+Cao&family=Long+Cang&display=swap');

    .profile-motto-script {
      align-items: flex-start;
      gap: 13px;
      min-height: 248px;
    }

    .profile-motto-script .motto-column {
      color: var(--navy-deep);
      font-weight: 400;
      line-height: .96;
      letter-spacing: .01em;
      text-shadow: 0 1px 0 rgba(255, 255, 255, .28);
      transform-origin: top center;
    }

    .profile-motto-script[data-length='short'] {
      min-height: 218px;
      gap: 20px;
    }

    .profile-motto-script[data-columns='3'] {
      gap: 7px;
      min-height: 238px;
    }

    .profile-motto-script.motto-font-long .motto-column,
    .profile-motto-script.motto-font-sweep .motto-column {
      font-family: 'Liu Jian Mao Cao', 'Long Cang', 'STXingkai', 'Xingkai SC', cursive;
    }

    .profile-motto-script.motto-font-long .motto-column {
      font-size: 45px;
    }

    .profile-motto-script.motto-font-sweep .motto-column {
      font-size: 53px;
    }

    .profile-motto-script.motto-font-long .motto-column:nth-child(1),
    .profile-motto-script.motto-font-sweep .motto-column:nth-child(1) {
      transform: rotate(2.35deg) translateY(-3px) scale(1.035);
    }

    .profile-motto-script.motto-font-long .motto-column:nth-child(2),
    .profile-motto-script.motto-font-sweep .motto-column:nth-child(2) {
      transform: rotate(-2.1deg) translateY(16px) scale(1.02);
    }

    .profile-motto-script.motto-font-long .motto-column:nth-child(3),
    .profile-motto-script.motto-font-sweep .motto-column:nth-child(3) {
      transform: rotate(1.45deg) translateY(2px) scale(1.025);
    }

    .profile-motto-script.motto-font-long[data-columns='3'] .motto-column {
      font-size: 34px;
    }

    .profile-motto-script.motto-font-sweep[data-columns='3'] .motto-column {
      font-size: 39px;
    }

    .profile-motto-script.is-randomized {
      animation: motto-ink-in .48s cubic-bezier(.2, .72, .2, 1) both;
    }

    @keyframes motto-ink-in {
      from { opacity: 0; transform: translateY(7px) scale(.985); filter: blur(1px); }
      to { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }
    }

    @media (max-width: 820px) {
      .profile-motto-script.motto-font-long .motto-column {
        font-size: 40px;
      }

      .profile-motto-script.motto-font-sweep .motto-column {
        font-size: 47px;
      }

      .profile-motto-script[data-columns='3'] .motto-column {
        font-size: 29px;
      }
    }

    @media (max-width: 680px) {
      .profile-motto-script,
      .profile-motto-script[data-columns='3'],
      .profile-motto-script[data-length='short'] {
        min-height: 184px;
      }

      .profile-motto-script.motto-font-long .motto-column {
        font-size: 36px;
      }

      .profile-motto-script.motto-font-sweep .motto-column {
        font-size: 42px;
      }

      .profile-motto-script[data-columns='3'] .motto-column {
        font-size: 25px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .profile-motto-script.is-randomized {
        animation: none;
      }
    }
  </style>

  <script is:inline>
    (() => {
      const mottoPool = [
        ['鹰击长空鲸霸海', '不试怎知龙与蚯'],
        ['自信人生二百年', '会当水击三千里'],
        ['今日长缨在手', '何时缚住苍龙'],
        ['问苍茫大地', '谁主沉浮？'],
        ['久有凌云志', '重上井冈山'],
        ['时来天地皆助力', '运去英雄不自由'],
        ['春来我不先开口', '哪个虫儿敢作声']
      ];
      const fontClasses = ['motto-font-long', 'motto-font-sweep'];
      const motto = document.querySelector('[data-random-motto]');

      if (!(motto instanceof HTMLElement)) return;

      const selected = mottoPool[Math.floor(Math.random() * mottoPool.length)];
      const maxLength = Math.max(...selected.map((line) => Array.from(line).length));
      const isShort = maxLength <= 6;
      const selectedFont = isShort ? 'motto-font-sweep' : 'motto-font-long';
      const fragment = document.createDocumentFragment();

      selected.forEach((line) => {
        const column = document.createElement('span');
        column.className = 'motto-column';
        column.textContent = line;
        fragment.appendChild(column);
      });

      motto.replaceChildren(fragment);
      motto.classList.remove(...fontClasses);
      motto.classList.add(selectedFont, 'is-randomized');
      motto.dataset.columns = String(selected.length);
      motto.dataset.length = isShort ? 'short' : 'standard';

      const label = selected.join('，');
      motto.setAttribute('aria-label', /[。！？]$/.test(label) ? label : `${label}。`);
    })();
  </script>
</BaseLayout>
