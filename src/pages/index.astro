---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { categories, topicLabels, formatDate } from '@/data/site';

const posts = (await getCollection('writing', ({ data }) =>
  !data.draft && data.visibility === 'public'
)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const latest = posts.slice(0, 6);
const years = [...new Set(posts.map((post) => post.data.publishedAt.getFullYear()))];
---
<BaseLayout title="KONG｜Finance × Computer Science" description="KONG 的个人主页与长期写作空间。">
  <section class="home-hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">SJTU · FINANCE × COMPUTER SCIENCE</p>
        <h1>KONG</h1>
        <p class="hero-lead">个人主页与长期写作空间。</p>
        <p class="hero-note">
          这里主要用来放文章、笔记和一些值得长期保留的文字。内容慢慢积累，结构也会随着写作继续调整。
        </p>
        <div class="hero-actions">
          <a class="primary-link" href="/writing/">Writing <span>→</span></a>
          <a href="/archive/">Archive</a>
          <a href="https://github.com/kong-158" rel="me">GitHub ↗</a>
        </div>
      </div>

      <aside class="ink-card" aria-label="随机题词">
        <div class="ink-card-top">
          <span>PERSONAL NOTES</span>
          <span>EST. 2026</span>
        </div>
        <div
          class="profile-motto-script motto-font-sweep"
          data-random-motto
          data-columns="2"
          data-length="standard"
          role="img"
          aria-label="鹰击长空鲸霸海，不试怎知龙与蚯。"
        >
          <span class="motto-column">鹰击长空鲸霸海</span>
          <span class="motto-column">不试怎知龙与蚯</span>
        </div>

        <span class="kt-easter-egg" title="KT" aria-label="KT #11">
          <img src="/kt-buddha.svg" alt="KT #11" width="96" height="96" loading="lazy" />
        </span>

        <div class="ink-card-bottom">
          <span class="ink-seal">空</span>
          <span>不定期更新，长期有效。</span>
        </div>
      </aside>
    </div>
  </section>

  <section class="home-section">
    <div class="shell home-section-grid">
      <div class="section-kicker">
        <span>01</span>
        <p>WRITING</p>
      </div>
      <div>
        <div class="home-heading heading-row">
          <div>
            <h2>Latest Writing</h2>
            <p>最近公开的文章与笔记。</p>
          </div>
          <a class="quiet-link" href="/writing/">全部文章 →</a>
        </div>
        {latest.length > 0 ? (
          <div class="home-post-list">
            {latest.map((post) => (
              <a href={`/writing/${post.id}/`}>
                <time>{formatDate(post.data.publishedAt)}</time>
                <div>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.summary}</p>
                </div>
                <span>{topicLabels[post.data.topic]}</span>
              </a>
            ))}
          </div>
        ) : (
          <div class="writing-start">
            <p class="writing-start-title">Writing starts here.</p>
            <p>文章区还在起步，之后的公开内容会从这里开始积累。</p>
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="home-section section-soft">
    <div class="shell home-section-grid">
      <div class="section-kicker">
        <span>02</span>
        <p>INDEX</p>
      </div>
      <div>
        <div class="home-heading">
          <h2>Browse by topic</h2>
        </div>
        <div class="topic-pills">
          {categories.map((category) => (
            <a href={`/topics/#${category.slug}`}>
              <span>{category.index}</span>
              <strong>{category.title}</strong>
              <small>{category.description}</small>
            </a>
          ))}
        </div>
        {years.length > 0 && (
          <div class="year-links">
            <span>ARCHIVE</span>
            {years.map((year) => <a href={`/archive/#year-${year}`}>{year}</a>)}
          </div>
        )}
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const mottoPool = [
        ['鹰击长空鲸霸海', '不试怎知龙与蚯'],
        ['自信人生二百年', '会当水击三千里'],
        ['今日长缨在手', '何时缚住苍龙'],
        ['问苍茫大地', '谁主沉浮？'],
        ['久有凌云志', '重上井冈山'],
        ['时来天地皆助力', '运去英雄不自由'],
        ['春来我不先开口', '哪个虫儿敢作声']
      ];
      const fontClasses = ['motto-font-long', 'motto-font-sweep'];
      const motto = document.querySelector('[data-random-motto]');

      if (!(motto instanceof HTMLElement)) return;

      const selected = mottoPool[Math.floor(Math.random() * mottoPool.length)];
      const maxLength = Math.max(...selected.map((line) => Array.from(line).length));
      const selectedFont = maxLength <= 6 ? 'motto-font-sweep' : 'motto-font-long';
      const fragment = document.createDocumentFragment();

      selected.forEach((line) => {
        const column = document.createElement('span');
        column.className = 'motto-column';
        column.textContent = line;
        fragment.appendChild(column);
      });

      motto.replaceChildren(fragment);
      motto.classList.remove(...fontClasses);
      motto.classList.add(selectedFont, 'is-randomized');
      motto.dataset.columns = String(selected.length);
      motto.dataset.length = maxLength <= 6 ? 'short' : 'standard';
      const label = selected.join('，');
      motto.setAttribute('aria-label', /[。！？]$/.test(label) ? label : `${label}。`);
    })();
  </script>
</BaseLayout>
