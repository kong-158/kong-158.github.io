---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { categories, topicLabels, kindLabels, formatDate } from '@/data/site';

const posts = (await getCollection('writing', ({ data }) =>
  !data.draft && data.visibility === 'public'
)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const recommended = posts.filter((post) => post.data.recommended);
const latest = posts.slice(0, 6);
const categoryCounts = Object.fromEntries(
  categories.map((category) => [
    category.slug,
    posts.filter((post) => post.data.topic === category.slug).length
  ])
);
const years = [...new Set(posts.map((post) => post.data.publishedAt.getFullYear()))];
---
<BaseLayout>
  <section class="profile-hero">
    <div class="shell profile-panel">
      <aside class="profile-sidebar">
        <img
          class="profile-avatar"
          src="https://avatars.githubusercontent.com/u/265462232?v=4"
          alt="刘科宏的头像"
          width="220"
          height="220"
        />
        <div class="profile-name-block">
          <h1>刘科宏</h1>
          <p>KONG · LIU KEHONG</p>
        </div>
        <dl class="profile-facts">
          <div><dt>学校</dt><dd>上海交通大学</dd></div>
          <div><dt>学习方向</dt><dd>金融学与计算机科学</dd></div>
          <div><dt>网站用途</dt><dd>学习、研究与随笔</dd></div>
        </dl>
      </aside>

      <div class="profile-introduction">
        <p class="report-label">PERSONAL PROFILE / 个人简介</p>
        <h2>你好，我叫刘科宏。</h2>
        <p class="profile-lead">
          我目前就读于上海交通大学金融计算机 F24。这个网站用来记录我的学习、研究、实践思考和一些随笔。
        </p>
        <p>
          这里的内容不会局限于某个固定方向：可能是一篇课程笔记、一段技术理解、一份金融研究整理，也可能是交易、实习、求职或生活中的阶段性记录。我的兴趣会随时间变化，这个网站也会跟着不断调整和生长。
        </p>
        <div class="profile-links">
          <a href="/writing/">阅读文章</a>
          <a href="/topics/">浏览栏目</a>
          <a href="/about/">更多介绍</a>
        </div>
      </div>
    </div>
  </section>

  {recommended.length > 0 && (
    <section class="section section-tint">
      <div class="shell">
        <div class="section-heading">
          <div><span class="section-no">01</span><h2>推荐阅读</h2></div>
        </div>
        <div class="article-list featured-list">
          {recommended.map((post) => (
            <a class="article-row" href={`/writing/${post.id}/`}>
              <time>{formatDate(post.data.publishedAt)}</time>
              <div class="article-main">
                <h3>{post.data.title}</h3>
                <p>{post.data.summary}</p>
              </div>
              <div class="article-meta">{topicLabels[post.data.topic]} · {kindLabels[post.data.kind]}</div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <div><span class="section-no">{recommended.length > 0 ? '02' : '01'}</span><h2>最新文章</h2></div>
        <a class="text-link" href="/writing/">查看全部</a>
      </div>
      {latest.length > 0 ? (
        <div class="article-list">
          {latest.map((post) => (
            <a class="article-row" href={`/writing/${post.id}/`}>
              <time>{formatDate(post.data.publishedAt)}</time>
              <div class="article-main">
                <h3>{post.data.title}</h3>
                <p>{post.data.summary}</p>
              </div>
              <div class="article-meta">{topicLabels[post.data.topic]} · {kindLabels[post.data.kind]}</div>
            </a>
          ))}
        </div>
      ) : (
        <div class="quiet-empty">
          <strong>目前还没有文章。</strong>
          <p>新的内容会陆续出现在这里。</p>
        </div>
      )}
    </div>
  </section>

  <section class="section section-tint">
    <div class="shell">
      <div class="section-heading">
        <div><span class="section-no">{recommended.length > 0 ? '03' : '02'}</span><h2>栏目浏览</h2></div>
        <p>按主题浏览文章、笔记与其他内容。</p>
      </div>
      <div class="category-table">
        {categories.map((category) => (
          <a class="category-row" href={`/topics/#${category.slug}`}>
            <span class="category-index">{category.index}</span>
            <div><h3>{category.title}</h3><p>{category.description}</p></div>
            <span class="category-count">{categoryCounts[category.slug]} 篇</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {years.length > 0 && (
    <section class="section">
      <div class="shell archive-strip">
        <div><span class="section-no">{recommended.length > 0 ? '04' : '03'}</span><h2>按时间归档</h2></div>
        <div class="archive-years">
          {years.map((year) => <a href={`/archive/#year-${year}`}>{year}</a>)}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
