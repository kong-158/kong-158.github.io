---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { categories, topicLabels, formatDate } from '@/data/site';

const posts = (await getCollection('writing', ({ data }) =>
  !data.draft && data.visibility === 'public'
)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const latest = posts.slice(0, 5);
const years = [...new Set(posts.map((post) => post.data.publishedAt.getFullYear()))];

const current = [
  {
    title: 'Quant & Markets',
    text: '因子、组合评价、市场研究，以及如何把金融问题变成可以验证的框架。'
  },
  {
    title: 'Data & ML',
    text: '数据分析、机器学习与深度学习，偏向能真正落地的问题和项目。'
  },
  {
    title: 'Computer Science',
    text: '算法、系统与工程工具。边学边做，把基础补成长期能力。'
  }
];

const selectedWork = [
  {
    id: 'factor-attribution',
    type: 'RESEARCH / ONGOING',
    title: 'Factor Attribution & Portfolio Evaluation',
    text: '围绕 Barra、Brinson、因子暴露与市场环境，尝试把传统归因和主动管理评价放进一个统一框架。',
    tags: ['Barra', 'Brinson', 'Quant']
  },
  {
    id: 'nba-playoff',
    type: 'MACHINE LEARNING / PROJECT',
    title: 'NBA Playoff Prediction',
    text: '从球员贡献与球队层面特征出发，构建分类、回归与 stacking 模型，研究常规赛信息对季后赛表现的解释力。',
    tags: ['Python', 'ML', 'Sports Analytics']
  }
];
---
<BaseLayout title="KONG｜Finance × Computer Science" description="KONG 的个人主页：金融、计算机、数据、研究与长期写作。">
  <section class="home-hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">SJTU · FINANCE × COMPUTER SCIENCE</p>
        <h1>KONG</h1>
        <p class="hero-lead">在金融、计算机与数据之间做研究、写代码、记笔记。</p>
        <p class="hero-note">
          这里是我的长期个人主页。比起展示一份静态简历，我更想持续留下正在学习什么、做过什么，以及一些阶段性的判断。
        </p>
        <div class="hero-actions">
          <a class="primary-link" href="/writing/">Writing <span>→</span></a>
          <a href="/projects/">Projects</a>
          <a href="https://github.com/kong-158" rel="me">GitHub ↗</a>
        </div>
      </div>

      <aside class="ink-card" aria-label="随机题词">
        <div class="ink-card-top">
          <span>PERSONAL NOTES</span>
          <span>EST. 2026</span>
        </div>
        <div
          class="profile-motto-script motto-font-sweep"
          data-random-motto
          data-columns="2"
          data-length="standard"
          role="img"
          aria-label="鹰击长空鲸霸海，不试怎知龙与蚯。"
        >
          <span class="motto-column">鹰击长空鲸霸海</span>
          <span class="motto-column">不试怎知龙与蚯</span>
        </div>
        <div class="ink-card-bottom">
          <span class="ink-seal">孔</span>
          <span>不定期更新，长期有效。</span>
        </div>
      </aside>
    </div>
  </section>

  <section class="home-section">
    <div class="shell home-section-grid">
      <div class="section-kicker">
        <span>01</span>
        <p>NOW</p>
      </div>
      <div>
        <div class="home-heading">
          <h2>最近关注的东西</h2>
          <p>方向会变，长期主线不会：理解问题，建立框架，然后做出来。</p>
        </div>
        <div class="now-list">
          {current.map((item) => (
            <article class="now-item">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="home-section section-soft">
    <div class="shell home-section-grid">
      <div class="section-kicker">
        <span>02</span>
        <p>WORK</p>
      </div>
      <div>
        <div class="home-heading heading-row">
          <div>
            <h2>Selected Work</h2>
            <p>不是简历流水账，只放值得继续迭代的东西。</p>
          </div>
          <a class="quiet-link" href="/projects/">全部项目 →</a>
        </div>
        <div class="work-grid">
          {selectedWork.map((project) => (
            <a class="work-card" href={`/projects/#${project.id}`}>
              <span class="work-type">{project.type}</span>
              <h3>{project.title}</h3>
              <p>{project.text}</p>
              <div class="tag-row">
                {project.tags.map((tag) => <span>{tag}</span>)}
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="home-section">
    <div class="shell home-section-grid">
      <div class="section-kicker">
        <span>03</span>
        <p>WRITING</p>
      </div>
      <div>
        <div class="home-heading heading-row">
          <div>
            <h2>Latest Writing</h2>
            <p>研究、技术、金融，以及一些值得留下来的笔记。</p>
          </div>
          <a class="quiet-link" href="/writing/">全部文章 →</a>
        </div>
        {latest.length > 0 ? (
          <div class="home-post-list">
            {latest.map((post) => (
              <a href={`/writing/${post.id}/`}>
                <time>{formatDate(post.data.publishedAt)}</time>
                <div>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.summary}</p>
                </div>
                <span>{topicLabels[post.data.topic]}</span>
              </a>
            ))}
          </div>
        ) : (
          <div class="writing-start">
            <p class="writing-start-title">Writing starts here.</p>
            <p>文章区还在起步。之后真正值得反复看的研究笔记、技术记录和长文会放到这里。</p>
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="home-section section-soft">
    <div class="shell home-section-grid">
      <div class="section-kicker">
        <span>04</span>
        <p>INDEX</p>
      </div>
      <div>
        <div class="home-heading">
          <h2>Browse by topic</h2>
        </div>
        <div class="topic-pills">
          {categories.map((category) => (
            <a href={`/topics/#${category.slug}`}>
              <span>{category.index}</span>
              <strong>{category.title}</strong>
              <small>{category.description}</small>
            </a>
          ))}
        </div>
        {years.length > 0 && (
          <div class="year-links">
            <span>ARCHIVE</span>
            {years.map((year) => <a href={`/archive/#year-${year}`}>{year}</a>)}
          </div>
        )}
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const mottoPool = [
        ['鹰击长空鲸霸海', '不试怎知龙与蚯'],
        ['自信人生二百年', '会当水击三千里'],
        ['今日长缨在手', '何时缚住苍龙'],
        ['问苍茫大地', '谁主沉浮？'],
        ['久有凌云志', '重上井冈山'],
        ['时来天地皆助力', '运去英雄不自由'],
        ['春来我不先开口', '哪个虫儿敢作声']
      ];
      const fontClasses = ['motto-font-long', 'motto-font-sweep'];
      const motto = document.querySelector('[data-random-motto]');

      if (!(motto instanceof HTMLElement)) return;

      const selected = mottoPool[Math.floor(Math.random() * mottoPool.length)];
      const maxLength = Math.max(...selected.map((line) => Array.from(line).length));
      const selectedFont = maxLength <= 6 ? 'motto-font-sweep' : 'motto-font-long';
      const fragment = document.createDocumentFragment();

      selected.forEach((line) => {
        const column = document.createElement('span');
        column.className = 'motto-column';
        column.textContent = line;
        fragment.appendChild(column);
      });

      motto.replaceChildren(fragment);
      motto.classList.remove(...fontClasses);
      motto.classList.add(selectedFont, 'is-randomized');
      motto.dataset.columns = String(selected.length);
      motto.dataset.length = maxLength <= 6 ? 'short' : 'standard';
      const label = selected.join('，');
      motto.setAttribute('aria-label', /[。！？]$/.test(label) ? label : `${label}。`);
    })();
  </script>
</BaseLayout>
