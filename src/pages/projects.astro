---
import BaseLayout from '@/layouts/BaseLayout.astro';

const projects = [
  {
    id: 'factor-attribution',
    no: '01',
    status: 'Research · Ongoing',
    title: 'Factor Attribution & Portfolio Evaluation',
    summary: '从 Barra + Brinson 出发，研究如何把因子暴露、主动收益、市场环境与主观多头评价放进一个更统一的框架。',
    details: [
      '传统 Brinson 归因与 Barra 风险因子的衔接',
      '市场环境适配、因子关系与反事实评价',
      '从解释框架走向可计算、可复用的指标体系'
    ],
    tags: ['Quant', 'Barra', 'Brinson', 'Research']
  },
  {
    id: 'nba-playoff',
    no: '02',
    status: 'Machine Learning · Project',
    title: 'NBA Playoff Prediction',
    summary: '基于 team-season 样本，从球员贡献与球队层面两组特征预测季后赛轮次与胜场，并尝试 stacking。',
    details: [
      '球员贡献：WS / VORP / BPM、滞后项与阵容结构特征',
      '球队层面：胜率、SRS、攻防效率、投篮与组织指标',
      '分类、回归与模型融合，保留未来赛季作为留出样本'
    ],
    tags: ['Python', 'ML', 'Sports Analytics', 'Stacking']
  },
  {
    id: 'personal-site',
    no: '03',
    status: 'Web · Living Project',
    title: 'This Website',
    summary: '一个长期维护的个人主页与写作系统。目标不是堆功能，而是让研究、项目、文章和阶段性兴趣有一个稳定入口。',
    details: [
      'Astro + Content Collections 的静态写作系统',
      'GitHub Pages 自动部署与 Markdown 内容流',
      '保留个人视觉元素，同时尽量保持信息密度和阅读体验'
    ],
    tags: ['Astro', 'Content', 'Design']
  }
];
---
<BaseLayout title="Projects｜KONG" description="KONG 的研究、机器学习与长期项目。">
  <section class="page-header">
    <div class="shell page-hero-copy">
      <p class="report-label">PROJECTS / 项目</p>
      <h1>做过的东西，比技能标签更重要。</h1>
      <p>这里只保留值得继续解释、迭代或复用的项目。实习经历不在这里按时间线罗列。</p>
    </div>
  </section>

  <section class="section page-section">
    <div class="shell projects-list">
      {projects.map((project) => (
        <article class="project-entry" id={project.id}>
          <div class="project-no">{project.no}</div>
          <div class="project-body">
            <p class="mini-label">{project.status}</p>
            <h2>{project.title}</h2>
            <p class="project-summary">{project.summary}</p>
            <ul>
              {project.details.map((detail) => <li>{detail}</li>)}
            </ul>
            <div class="tag-row">
              {project.tags.map((tag) => <span>{tag}</span>)}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
