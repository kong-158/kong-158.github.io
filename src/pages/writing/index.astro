---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { topicLabels, kindLabels, formatDate } from '@/data/site';

const posts = (await getCollection('writing', ({ data }) =>
  !data.draft && data.visibility === 'public'
)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---
<BaseLayout title="文章｜刘科宏" description="刘科宏公开发布的文章、笔记、复盘与研究整理。">
  <section class="page-header">
    <div class="shell">
      <p class="report-label">PUBLIC WRITING / 公开文章</p>
      <h1>文章</h1>
      <p>按发布时间排列。推荐与否不会影响普通文章的正常展示。</p>
    </div>
  </section>
  <section class="section page-section">
    <div class="shell">
      {posts.length > 0 ? (
        <div class="article-list">
          {posts.map((post) => (
            <a class="article-row" href={`/writing/${post.id}/`}>
              <time>{formatDate(post.data.publishedAt)}</time>
              <div class="article-main">
                <h2>{post.data.title}</h2>
                <p>{post.data.summary}</p>
              </div>
              <div class="article-meta">{topicLabels[post.data.topic]} · {kindLabels[post.data.kind]}</div>
            </a>
          ))}
        </div>
      ) : (
        <div class="quiet-empty">
          <strong>目前尚无公开文章。</strong>
          <p>草稿、私人内容和未明确发布的记录不会出现在这里。</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
