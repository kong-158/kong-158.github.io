---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { topicLabels, kindLabels, formatDate, series } from '@/data/site';

export async function getStaticPaths() {
  const posts = await getCollection('writing', ({ data }) =>
    !data.draft && data.visibility !== 'private'
  );
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const seriesMeta = post.data.series
  ? series[post.data.series as keyof typeof series]
  : undefined;
---
<BaseLayout title={`${post.data.title}｜KONG`} description={post.data.summary}>
  <article class="report-article">
    <header class="article-header shell-narrow">
      <div class="article-classification">
        {topicLabels[post.data.topic]} · {kindLabels[post.data.kind]}
        {seriesMeta && (
          <> · <a href={`/series/${post.data.series}/`}>{seriesMeta.shortTitle}</a></>
        )}
      </div>
      <h1>{post.data.title}</h1>
      <div class="article-byline">
        <time>{formatDate(post.data.publishedAt)}</time>
        {post.data.updatedAt && <span>更新于 {formatDate(post.data.updatedAt)}</span>}
      </div>
      <div class="abstract-box">
        <strong>摘要</strong>
        <p>{post.data.summary}</p>
      </div>
    </header>
    <div class="shell-narrow prose"><Content /></div>
  </article>
</BaseLayout>
