---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { series, topicLabels, kindLabels, formatDate } from '@/data/site';

export function getStaticPaths() {
  return Object.entries(series)
    .filter(([slug]) => slug !== 'cmc-calculus')
    .map(([slug, item]) => ({
      params: { slug },
      props: { slug, item }
    }));
}

const { slug, item } = Astro.props;
const posts = (await getCollection('writing', ({ data }) =>
  !data.draft && data.visibility === 'public' && data.series === slug
)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---
<BaseLayout title={`${item.title}｜KONG`} description={item.description}>
  <section class="page-header">
    <div class="shell">
      <p class="report-label">SERIES / {item.shortTitle}</p>
      <h1>{item.title}</h1>
      <p>{item.description}</p>
    </div>
  </section>

  <section class="section page-section">
    <div class="shell">
      {posts.length > 0 ? (
        <div class="article-list">
          {posts.map((post) => (
            <a class="article-row" href={`/writing/${post.id}/`}>
              <time>{formatDate(post.data.publishedAt)}</time>
              <div class="article-main">
                <h2>{post.data.title}</h2>
                <p>{post.data.summary}</p>
              </div>
              <div class="article-meta">{topicLabels[post.data.topic]} · {kindLabels[post.data.kind]}</div>
            </a>
          ))}
        </div>
      ) : (
        <div class="quiet-empty">
          <strong>这个系列已经建好。</strong>
          <p>内容会持续补充。</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
