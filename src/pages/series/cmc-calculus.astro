        <section class="book-index">
          <div class="book-index-title">
            <span>02</span>
            <div>
              <h3>强化篇</h3>
              <p>高等数学 · P.189 起</p>
            </div>
          </div>
          <ol>
            {advanced.map((item) => (
              <li class:list={{ 'has-note': item.no === 1 }}>
                {item.no === 1 ? (
                  <a href="#chapter-1">
                    <span class="chapter-no">{String(item.no).padStart(2, '0')}</span>
                    <span class="chapter-title">{item.title}</span>
                    <span class="chapter-page">P.{item.page}</span>
                  </a>
                ) : (
                  <div>
                    <span class="chapter-no">{String(item.no).padStart(2, '0')}</span>
                    <span class="chapter-title">{item.title}</span>
