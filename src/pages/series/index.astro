---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { series, kindLabels, formatDate } from '@/data/site';

const posts = (await getCollection('writing', ({ data }) =>
  !data.draft && data.visibility === 'public'
)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const entries = Object.entries(series);
---
<BaseLayout title="系列｜KONG" description="按长期专题浏览文章与笔记。">
  <section class="page-header">
    <div class="shell">
      <p class="report-label">SERIES / 系列文章</p>
      <h1>系列</h1>
      <p>把会持续更新、需要反复回看的内容集中在一起。</p>
    </div>
  </section>

  <section class="section page-section">
    <div class="shell topic-sections">
      {entries.map(([slug, item]) => {
        const seriesPosts = posts.filter((post) => post.data.series === slug);
        return (
          <section class="topic-section" id={slug}>
            <div class="topic-header">
              <span>{item.index}</span>
              <div>
                <h2><a href={`/series/${slug}/`}>{item.title}</a></h2>
                <p>{item.description}</p>
              </div>
              <a class="text-link" href={`/series/${slug}/`}>进入系列</a>
            </div>

            {seriesPosts.length > 0 ? (
              <div class="compact-list">
                {seriesPosts.slice(0, 5).map((post) => (
                  <a href={`/writing/${post.id}/`}>
                    <time>{formatDate(post.data.publishedAt)}</time>
                    <span>{post.data.title}</span>
                    <small>{kindLabels[post.data.kind]}</small>
                  </a>
                ))}
              </div>
            ) : (
              <p class="topic-empty">这个系列刚刚开篇，后续内容会从这里继续积累。</p>
            )}
          </section>
        );
      })}
    </div>
  </section>
</BaseLayout>
