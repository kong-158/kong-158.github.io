---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { series } from '@/data/site';

const entries = Object.entries(series);
---
<BaseLayout title="系列｜KONG" description="持续更新的专题笔记与长期整理。">
  <section class="page-header">
    <div class="shell">
      <p class="report-label">SERIES / 长期整理</p>
      <h1>系列</h1>
      <p>不是一次性文章，而是会反复更新、不断补充目录和内容的长期页面。</p>
    </div>
  </section>

  <section class="section page-section">
    <div class="shell topic-sections">
      {entries.map(([slug, item]) => (
        <section class="topic-section" id={slug}>
          <div class="topic-header">
            <span>{item.index}</span>
            <div>
              <h2><a href={`/series/${slug}/`}>{item.title}</a></h2>
              <p>{item.description}</p>
            </div>
            <a class="text-link" href={`/series/${slug}/`}>进入系列</a>
          </div>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
